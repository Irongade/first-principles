# Identity and cluster membership
NODE_ID=1
NODE_LEADER=1
NODE_PEERS=1=http://localhost:8081,2=http://localhost:8082,3=http://localhost:8083

# Where this process listens. Advertised address is the NODE_PEERS entry for NODE_ID.
NODE_ADDR=:8081

# Per-node root. log/ and db/ are created beneath it.
NODE_DATA_DIR=../data/node-1

# State machine driver. Only "kv" exists today.
STATE_MACHINE_DRIVER=kv

# The kv driver also reads kv-store's STORE_* variables.
# STORE_DATA_DIR is ignored; the node sets it to NODE_DATA_DIR/db.
# See ../kv-store/.env.example for the rest.
