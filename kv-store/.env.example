# kvstore configuration
#
# Every variable is optional. Unset -> the built-in default is used silently.
# Set but unparseable -> a warning is logged and the default is used anyway.


# Store version to be appended to each record.
STORE_VERSION=V1

# Directory where store files live for simple storage format
STORE_FILENAME=text.txt

# Directory where segment files live.
STORE_DATA_DIR=data

# --- sizes -----------------------------------------------------------------

# Bytes written to a segment before it rotates to a new file.
STORE_MAX_SEGMENT_SIZE=1048576

# Write buffer size in bytes. Keep well below MAX_SEGMENT_SIZE or segments
# overshoot their threshold by up to one buffer.
STORE_BUFFER_SIZE=32768

# Largest single record the scanner will buffer. A record bigger than this
# fails to read rather than growing the buffer without limit.
# Must be >= BUFFER_SIZE.
STORE_MAX_RECORD_SIZE=4194304

# Minimum number of stale (sealed) segments before compaction bothers running.
STORE_STALE_SEGMENT_THRESHOLD=5

# --- compaction ------------------------------------------------------------

# How often the background compaction ticker fires.
# Go duration string: 30s, 5m, 1h30m.
STORE_ENABLE_COMPACTION=true

# How often the background compaction ticker fires.
# Go duration string: 30s, 5m, 1h30m.
STORE_COMPACTION_INTERVAL=5m

# --- formats ---------------------------------------------------------------

# Storage format: segment | simple
STORE_STORAGE_FORMAT=segment

# Index format: value | position
# Compaction only runs under 'position'.
STORE_INDEX_FORMAT=position

# Record encoding: text (only supported value today)
STORE_FORMATTER=text

# --- durability ------------------------------------------------------------

# When to fsync: never | every-write
# 'never' is much faster but loses recent writes on a crash.
STORE_SYNC_POLICY=every-write
